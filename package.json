{
  "name": "sexhouseisland",
  "version": "0.1.0",
  "private": true,
  "description": "Sex House Island — Season 50 promotional site (React + Vite) with a client-side prediction-market platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "vite build",
    "preview": "vite preview",
    "gen": "tsx scripts/generate-sprite.ts",
    "gen:walk": "tsx scripts/generate-walk.ts",
    "gen:portrait": "tsx scripts/generate-portrait.ts",
    "gen:bg": "tsx scripts/generate-bg.ts",
    "gen:variants": "tsx scripts/gen-variants.ts",
    "bake:variant": "tsx scripts/bake-variant.ts",
    "start": "node server.mjs",
    "serve": "npm run build && node server.mjs",
    "scenes:pull": "node scripts/scenes.mjs pull",
    "scenes:push": "node scripts/scenes.mjs push",
    "trace": "tsx scripts/trace-sprite.ts",
    "gen:poses": "tsx scripts/walk-poses.ts",
    "gen:cast": "node scripts/gen-cast.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
